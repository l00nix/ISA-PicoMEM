+       (ep_addr != ((cbw->dir & TUSB_DIR_IN_MASK) ? p_msc->ep_in : p_msc->ep_out) ||
+        ((pm_sense || pm_cache) ? xferred_bytes > cbw->total_bytes : xferred_bytes != cbw->total_bytes))) ||
+      (p_msc->stage == MSC_STAGE_STATUS &&
