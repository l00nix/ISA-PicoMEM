+#ifdef PICOMEM_EXPERIMENTAL_USB_SYNC
+/* Fail the application command instead of accepting stale/partial CSW bytes.
+ * No automatic reset or retry: the PicoMEM adapter quarantines its owned buffer.
+ */
+bool tuh_msc_get_checked_reply(uint8_t dev_addr, uint32_t tag,
+                               tuh_msc_checked_fault_t *out) {
+  if (!dev_addr || dev_addr > CFG_TUH_DEVICE_MAX || !out) return false;
+  msch_interface_t const *itf = get_itf(dev_addr);
+  if (!itf->pm_recorded || itf->pm_fault.tag != tag) return false;
+  *out = itf->pm_fault;
+  return true;
+}
+
+bool tuh_msc_get_checked_fault(uint8_t dev_addr, uint32_t tag,
+                               tuh_msc_checked_fault_t *out) {
+  if (!dev_addr || dev_addr > CFG_TUH_DEVICE_MAX || !out ||
+      !get_itf(dev_addr)->pm_fault.reason) return false;
+  return tuh_msc_get_checked_reply(dev_addr, tag, out);
+}
+
+/* Called before synthetic CSW replacement; never interpret partial/stale CSW.
+ * Classification mirrors the checks below without changing their acceptance.
+ */
+static void pm_msch_record(uint8_t dev_addr, uint8_t ep, xfer_result_t event,
+                           uint32_t actual, bool rejected) {
+  msch_interface_t *itf = get_itf(dev_addr);
+  msch_epbuf_t *b = get_epbuf(dev_addr);
+  tuh_msc_checked_fault_t *f = &itf->pm_fault;
+  if (itf->pm_recorded) return;
+  itf->pm_recorded = true;
+  f->sample_length = itf->pm_sample_length;
+  memcpy(f->sample, itf->pm_sample, sizeof(f->sample));
+  f->tag = b->cbw.tag;
+  f->opcode = b->cbw.command[0];
+  f->stage = itf->stage;
+  f->event = event;
+  f->endpoint = ep;
+  f->expected_endpoint = itf->stage == MSC_STAGE_CMD ? itf->ep_out :
+    itf->stage == MSC_STAGE_DATA && !(b->cbw.dir & TUSB_DIR_IN_MASK) ? itf->ep_out : itf->ep_in;
+  f->actual = actual;
+  f->expected = itf->stage == MSC_STAGE_CMD ? sizeof(msc_cbw_t) :
+    itf->stage == MSC_STAGE_DATA ? b->cbw.total_bytes : sizeof(msc_csw_t);
+  f->data_bytes = itf->stage == MSC_STAGE_DATA ? actual : itf->pm_data_bytes;
+  f->csw_status = 255;
+  f->residue = UINT32_MAX;
+  if (itf->stage == MSC_STAGE_STATUS && event == XFER_RESULT_SUCCESS &&
+      ep == itf->ep_in && actual == sizeof(msc_csw_t)) {
+    f->csw_status = b->csw.status;
+    f->residue = b->csw.data_residue;
+    f->checks = 1;
+    if (b->csw.signature == MSC_CSW_SIGNATURE) f->checks |= 2;
+    if (b->csw.tag == b->cbw.tag) f->checks |= 4;
+    if (b->csw.data_residue <= b->cbw.total_bytes) {
+      f->checks |= 8;
+      if (itf->pm_data_bytes == b->cbw.total_bytes - b->csw.data_residue) f->checks |= 32;
+    }
+    if (b->csw.status <= 2) f->checks |= 16;
+  }
+  if (!rejected) f->reason = b->csw.status == 2 ? 9 : 0;
+  else if (event != XFER_RESULT_SUCCESS) f->reason = 1;
+  else if (ep != f->expected_endpoint) f->reason = 2;
+  else if (!(f->checks & 1)) f->reason = 3;
+  else if (!(f->checks & 2)) f->reason = 4;
+  else if (!(f->checks & 4)) f->reason = 5;
+  else if (!(f->checks & 8)) f->reason = 6;
+  else if (!(f->checks & 16)) f->reason = 7;
+  else if (b->csw.status == 2) f->reason = 9;
+  else f->reason = 8;
+}
+
+static bool pm_msch_failed(uint8_t dev_addr) {
+  msch_interface_t* itf = get_itf(dev_addr);
+  msch_epbuf_t* epbuf = get_epbuf(dev_addr);
+  itf->stage = MSC_STAGE_IDLE;
+  tu_memclr(&epbuf->csw, sizeof(msc_csw_t));
+  epbuf->csw.signature = MSC_CSW_SIGNATURE;
+  epbuf->csw.tag = epbuf->cbw.tag;
+  epbuf->csw.data_residue = epbuf->cbw.total_bytes;
+  epbuf->csw.status = 2; /* Synthetic phase error, never success. */
+  if (itf->complete_cb) {
+    tuh_msc_complete_data_t const data = {
+      .cbw = &epbuf->cbw, .csw = &epbuf->csw,
+      .scsi_data = itf->buffer, .user_arg = itf->complete_arg
+    };
+    itf->complete_cb(dev_addr, &data);
+  }
+  return false;
+}
