+bool tuh_msc_get_pending(uint8_t dev_addr, uint32_t tag, tuh_msc_pending_t *out) {
+  if (!dev_addr || dev_addr > CFG_TUH_DEVICE_MAX || !out) return false;
+  msch_interface_t const *itf = get_itf(dev_addr);
