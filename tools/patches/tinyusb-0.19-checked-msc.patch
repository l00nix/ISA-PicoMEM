+#ifdef PICOMEM_EXPERIMENTAL_USB_SYNC
+/* PM_HOST_SNAPSHOT_BEGIN: exercised against fake registers in host tests. */
+bool pm_usb_host_snapshot(uint8_t dev_addr, uint8_t ep_addr, pm_usb_host_state_t *out)
+{
+  if (!out || !dev_addr || dev_addr > 127 || !(ep_addr & 15) || (ep_addr & 0x70)) return false;
+  uint32_t saved = save_and_disable_interrupts();
+  struct hw_endpoint *ep = get_dev_ep(dev_addr, ep_addr);
+  if (!ep || !ep->configured || !ep->buffer_control || !ep->endpoint_control ||
+      ep->interrupt_num >= PICO_USB_HOST_INTERRUPT_ENDPOINTS) {
+    restore_interrupts(saved);
+    return false;
+  }
+  /* Only non-control slots: no endpoint payload or partial CSW is inspected. */
+  memset(out, 0, sizeof(*out));
+  out->slot = ep->interrupt_num + 1;
+  out->active = ep->active;
+  out->remaining = ep->remaining_len;
+  out->transferred = ep->xferred_len;
+  out->buffer_ctrl = *ep->buffer_control;
+  out->endpoint_ctrl = *ep->endpoint_control;
+  out->address_ctrl = usb_hw->int_ep_addr_ctrl[ep->interrupt_num];
+  out->poll_ctrl = usb_hw->int_ep_ctrl;
+  out->sie_ctrl = usb_hw->sie_ctrl;
+  out->sie_status = usb_hw->sie_status;
+  out->buffer_status = usb_hw->buf_status;
+  out->ints = usb_hw->ints;
+  out->inte = usb_hw->inte;
+  out->frame = usb_hw->sof_rd;
+#if PICO_RP2350
+  out->sm_state = usb_hw->sm_state;
+#endif
+  restore_interrupts(saved);
+  return true;
+}
+/* PM_HOST_SNAPSHOT_END */
+#endif
