+#ifdef PICOMEM_EXPERIMENTAL_USB_SYNC
+#include "host/hcd.h"
+/* Terminal transfer evidence. Reasons: 0 checked completion, 1 event, 2 endpoint, 3 length, 4 CSW
+ * signature, 5 tag, 6 residue, 7 status, 8 DATA/residue, 9 device phase error.
+ * Stage uses MSC_STAGE_* (CMD=1, DATA=2, STATUS=3). Unknown CSW: status=255,
+ * residue=UINT32_MAX. checks bits: present, signature, tag, residue, status,
+ * DATA/residue agreement. A present CSW requires a complete successful IN.
+ * Successful bounded MODE queries may lack agreement; consume no more than
+ * min(data_bytes, allocation - residue). The sample never sets cache policy.
+ */
+typedef struct {
+  uint32_t tag, actual, expected, data_bytes, residue;
+  uint8_t stage, event, endpoint, expected_endpoint;
+  uint8_t reason, csw_status, checks, opcode;
+  uint8_t sample_length, sample[16]; /* Accepted MODE SENSE DATA prefix only. */
+} tuh_msc_checked_fault_t;
+/* Pending command snapshot, core-0 only, no USB work or CSW/data-buffer reads.
+ * submitted: 0 not attempted, 1 accepted by host driver, 2 rejected.
+ * last_stage=0 and last_event=255 mean no completion callback yet.
+ * Accepted submission does not prove a physical bus transaction occurred. */
+typedef struct {
+  uint32_t tag, expected, last_actual;
+  uint8_t opcode, stage, endpoint, submitted;
+  uint8_t last_stage, last_event, last_endpoint;
+  uint8_t host_start_valid, host_valid;
+  uint32_t host_start_frame;
+  pm_usb_host_state_t host;
+} tuh_msc_pending_t;
+bool tuh_msc_get_pending(uint8_t dev_addr, uint32_t tag, tuh_msc_pending_t *out);
+/* No USB work; core-0 only. Valid until the next command or device close. */
+bool tuh_msc_get_checked_fault(uint8_t dev_addr, uint32_t tag,
+                               tuh_msc_checked_fault_t *out);
+/* Includes checked status-0/1 completion; sample is evidence, not cache policy.
+ * No sample from non-MODE-SENSE, failed DATA, wrong endpoint or excess length. */
+bool tuh_msc_get_checked_reply(uint8_t dev_addr, uint32_t tag,
+                               tuh_msc_checked_fault_t *out);
+#endif
+
