+      itf->pm_recorded || itf->pm_pending.tag != tag ||
+      itf->pm_pending.stage != itf->stage) return false;
+  *out = itf->pm_pending;
+  out->host_valid = pm_usb_host_snapshot(dev_addr, out->endpoint, &out->host);
+  return true;
+}
