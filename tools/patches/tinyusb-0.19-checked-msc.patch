+#ifdef PICOMEM_EXPERIMENTAL_USB_SYNC
+/* Fail the application command instead of accepting stale/partial CSW bytes.
+ * No automatic reset or retry: the PicoMEM adapter quarantines its owned buffer.
+ */
+static bool pm_msch_failed(uint8_t dev_addr) {
+  msch_interface_t* itf = get_itf(dev_addr);
+  msch_epbuf_t* epbuf = get_epbuf(dev_addr);
+  itf->stage = MSC_STAGE_IDLE;
+  tu_memclr(&epbuf->csw, sizeof(msc_csw_t));
+  epbuf->csw.signature = MSC_CSW_SIGNATURE;
+  epbuf->csw.tag = epbuf->cbw.tag;
+  epbuf->csw.data_residue = epbuf->cbw.total_bytes;
+  epbuf->csw.status = 2; /* Synthetic phase error, never success. */
+  if (itf->complete_cb) {
+    tuh_msc_complete_data_t const data = {
+      .cbw = &epbuf->cbw, .csw = &epbuf->csw,
+      .scsi_data = itf->buffer, .user_arg = itf->complete_arg
+    };
+    itf->complete_cb(dev_addr, &data);
+  }
+  return false;
+}
+#endif
